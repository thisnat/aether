{
  "name": "aether",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "build": "vite build && node scripts/build-if-needed.js --save-only",
    "build:check": "node scripts/build-if-needed.js",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server.js",
    "dev:client": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prestart": "node scripts/build-if-needed.js",
    "start": "node server.js",
    "test": "node tests/test-crud.js"
  },
  "description": "Minimal local-network markdown note-taking app",
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "chokidar": "^5.0.0",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.64.0",
    "marked": "^18.1.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  }
}
